# Copy to .env and fill in. Never commit real secrets.
#
# Two setups, one switch: DJANGO_DEBUG=True -> local dev (SQLite, plain HTTP).
# DJANGO_DEBUG=False -> full production setup (closed hosts, HTTPS redirect +
# HSTS, secure cookies). Every variable below is optional — secure or sensible
# defaults apply — except the bKash creds (needed for real payments) and
# DJANGO_SUPERUSER_PASSWORD (needed by setup_production).

# --- Django core ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_TIME_ZONE=Asia/Dhaka
SITE_URL=https://bbccictfest.pro.bd

# --- Hosts (production defaults to your SITE_URL host; list more if needed) ---
DJANGO_ALLOWED_HOSTS=bbccictfest.pro.bd,www.bbccictfest.pro.bd,bbccictfest.onrender.com,www.bbccictfest.onrender.com,*.onrender.com,*bbccictfest.pro.bd
DJANGO_CSRF_TRUSTED_ORIGINS=https://bbccictfest.pro.bd,https://www.bbccictfest.pro.bd

# --- Database ---
# Empty = local SQLite file. Set DATABASE_URL for Postgres (production).
#DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/bbccictfest
#DATABASE_URL=sqlite:///db.sqlite3
#SQLITE_NAME=db.sqlite3

# --- Production hardening overrides (secure defaults already apply) ---
#DJANGO_SECURE_SSL_REDIRECT=True
#DJANGO_SECURE_HSTS_SECONDS=31536000
#DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
#DJANGO_SECURE_HSTS_PRELOAD=False
#DJANGO_SECURE_REFERRER_POLICY=same-origin

# --- bKash tokenized checkout creds (https://github.com/Itsmmdoha/pybkash) ---
# Leave empty for MOCK mode local dev; fill for sandbox/prod.
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_SANDBOX=True
BKASH_MOCK=False
BKASH_CALLBACK_BASE=https://bbccictfest.pro.bd

# --- setup_production command: creates (or resets) the admin superuser ---
# DJANGO_SUPERUSER_PASSWORD is required — the command refuses to run without it.
#DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=BBCC
DJANGO_SUPERUSER_PASSWORD=admin
